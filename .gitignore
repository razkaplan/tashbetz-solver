# Raw scraped corpus — not redistributed (copyright: Haaretz / community site).
# Reconstructible from public sources via ./bootstrap.sh
data/
# ...except these, which are not newspaper content:
!data/image_urls.txt      # URLs only, no content — lets bootstrap fetch from the public CDN
!data/articles.txt        # article date -> id manifest
!data/grids/              # black/white cell patterns: factual layout, our own transcription
!data/grids/*.json
# the hosted app data bundle (derived indices + demo excerpt) must ship with the site
!docs/
!docs/solve/data/
!docs/solve/data/**
solver/lex/hspell.txt
# scratch / tooling
__pycache__/
*.pyc
scraper/*.json
web/site_data.json.bak
node_modules/
.DS_Store
.vercel
web/
__pycache__/
*.pyc
# assistant runtime state (contains puzzle content — never republish)
app/uploads/
app/puzzles/
data/sessions/

# local Vercel env pulls (secrets)
.env.vercel
docs/.env.vercel
